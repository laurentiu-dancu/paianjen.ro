<header class="bg-white border-b border-stone-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <.link navigate={~p"/"} class="flex items-center gap-2 group">
          <span class="text-2xl">🕷️</span>
          <span class="text-xl font-bold tracking-tight text-stone-800 group-hover:text-amber-600 transition-colors">
            paianjen
          </span>
        </.link>
        <span class="text-xs text-stone-400 hidden sm:inline">mic motor de căutare imobiliară</span>
      </div>
      <nav class="flex items-center gap-6">
        <.link navigate={~p"/listings"} class="text-sm font-medium text-stone-600 hover:text-amber-600 transition-colors">
          Anunțuri
        </.link>
      </nav>
    </div>
  </div>
</header>

<main class="flex-1">
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>

<footer class="bg-white border-t border-stone-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-stone-500">
        <span>🕷️</span>
        <span>paianjen.ro — motor de căutare imobiliară</span>
      </div>
      <div class="text-xs text-stone-400">
        Date colectate din Cluj-Napoca și județul Cluj
      </div>
    </div>
  </div>
</footer>
